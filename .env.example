# =============================================================================
# 이 파일(.env.example)만 Git에 올립니다.
# 실제 키는 복사본 .env 에 넣고 절대 커밋하지 마세요.
#   cp .env.example .env
# 스토어 제출용 비밀은 EAS Secrets / Play·Apple Console에 두세요.
# =============================================================================

# Optional: Pexels API (없어도 로컬 Fluent Emoji 일러스트로 동작)
EXPO_PUBLIC_PEXELS_API_KEY=

# Optional: 추후 Kakao / Firebase 등 (네이티브 키는 EAS Secrets 권장)
# EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
# EXPO_PUBLIC_FIREBASE_API_KEY=
