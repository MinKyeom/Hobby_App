# =============================================================================
# Hobby_App /.gitignore
# -----------------------------------------------------------------------------
# [커밋 OK]  소스(src/), 공개 에셋(assets/), public/*.html, app.json, eas.json,
#            package.json / package-lock.json, .env.example, LICENSE, 문서(*.md),
#            babel/tsconfig, scripts/*.mjs (비밀 없는 유틸)
#
# [커밋 금지] 비밀키·인증서·서비스계정, .env 실값, node_modules, .expo 캐시,
#              로컬 생성 ios/android, 스토어 빌드 산출물(ipa/apk/aab), 로그/캐시
# =============================================================================

# =========================
# Dependencies (재설치 가능 → 금지)
# =========================
node_modules/
.pnp
.pnp.js
.pnp.cjs
.yarn/install-state.gz
.yarn/cache/
.pnpm-store/

# =========================
# 환경변수 · 비밀 (절대 커밋 금지)
# 예외: .env.example 만 커밋 (키 자리표시자)
# =========================
.env
.env.*
!.env.example

# 인증서 / 키스토어 / 프로비저닝
*.pem
*.p8
*.p12
*.pfx
*.cer
*.cert
*.key
*.mobileprovision
*.jks
*.keystore
*.jks.b64
*.keystore.b64
AuthKey_*.p8

# 클라우드·스토어 자격증명
secrets/
**/secrets/
credentials/
**/credentials/
credentials.json
**/credentials.json
service-account*.json
*-service-account.json
*serviceAccount*.json
google-services.json
GoogleService-Info.plist
google-play*.json
play-store*.json
asc_api_key.json
api-key*.json
*-credentials.json
eas-credentials/
.expo-shared/credentials.json

# SSH / 로컬 시크릿
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.secret
*.secrets
.secrets

# =========================
# Expo / Metro / 번들러 (로컬 캐시 → 금지)
# =========================
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
*.orig.*
.expo-shared/
!.expo-shared/.gitkeep

# =========================
# Native (CNG: eas/prebuild 로컬 생성 → 금지)
# 수동 eject 정책으로 ios/android를 커밋할 때만 아래 두 줄을 제거하세요.
# =========================
/ios
/android
.kotlin/

# =========================
# EAS / 스토어 빌드 산출물 (바이너리 → 금지)
# eas.json 자체는 커밋 OK (비밀 없는 빌드 프로필)
# play-store/graphics · screenshots · *.md 는 커밋 OK
# =========================
*.ipa
*.apk
*.aab
*.apks
*.obb
*.dSYM.zip
*.app.dSYM.zip
build-*.tar.gz
play-store/builds/**
!play-store/builds/.gitkeep
play-store/secrets/**
!play-store/secrets/.gitkeep

# 에셋 생성용 로컬 venv (재생성 가능)
.venv-assets/
.venv/

# 로컬 캡처·미사용 원본 스크린샷 덤프
play-store/screenshots/**/raw/
play-store/screenshots/**/.device-capture/
*.xcarchive/

# =========================
# 디버그 / 로그 / 커버리지
# =========================
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
bun-debug.*
*.log
logs/
coverage/
.nyc_output/
report.*.json
scripts/*-report.json

# =========================
# TypeScript / 툴 캐시
# =========================
*.tsbuildinfo
.turbo/
.cache/
.eslintcache
.parcel-cache/
.vite/

# =========================
# OS / IDE
# =========================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
~$*

# =========================
# 로컬 잡파일 / 배포 도구 캐시
# =========================
tmp/
temp/
*.tmp
*.bak
*.old
*.orig
.vercel
.firebase/
firebase-debug.log
.cursor/
agent-transcripts/
.eas-cli/
.eastemp/
