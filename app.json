{
  "expo": {
    "name": "오피스 동물 진단",
    "slug": "workplace-animal-diagnosis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "workplaceanimaldiagnosis",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "description": "성인·직장인 대상. 부하편·상사편 소통 성향을 동물 유형과 ___력으로 알아보는 엔터테인먼트 진단. 가입 없이 이용.",
    "primaryColor": "#2F6B4F",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#DFF3F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.minkyeom.workplaceanimaldiagnosis",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "오피스 동물 진단",
        "NSPhotoLibraryAddUsageDescription": "진단 결과 카드 이미지를 사진 앱에 저장하기 위해서만 사용합니다. 기존 사진을 읽거나 업로드하지 않습니다.",
        "NSPhotoLibraryUsageDescription": "진단 결과 카드 이미지를 사진 앱에 저장하기 위해서만 사용합니다. 기존 사진을 읽거나 업로드하지 않습니다.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "kakaotalk",
          "twitter",
          "fb",
          "instagram"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": []
      }
    },
    "android": {
      "package": "com.minkyeom.workplaceanimaldiagnosis",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#DFF3F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.minkyeom.workplaceanimaldiagnosis",
      "blockedPermissions": [
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_PHONE_STATE",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "진단 결과 카드 이미지를 사진 앱에 저장하기 위해서만 사용합니다. 기존 사진을 읽거나 업로드하지 않습니다.",
          "savePhotosPermission": "진단 결과 카드 이미지를 사진 앱에 저장하기 위해서만 사용합니다. 기존 사진을 읽거나 업로드하지 않습니다.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DFF3F0",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportsRTL": false,
      "storeCompliance": {
        "privacyPolicyUrl": "https://minkyeom.github.io/Hobby_App/privacy.html",
        "supportUrl": "https://minkyeom.github.io/Hobby_App/support.html",
        "licensesUrl": "https://minkyeom.github.io/Hobby_App/licenses.html",
        "targetAgeMin": 18,
        "targetAudience": "adults-workplace",
        "containsAds": false,
        "dataCollection": "none-server"
      }
    }
  }
}
