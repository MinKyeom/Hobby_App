{
  "name": "workplace-animal-diagnosis",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "eas:whoami": "npx eas-cli@latest whoami",
    "eas:init": "npx eas-cli@latest init --account minkowskim --non-interactive --force --icon",
    "eas:build:preview": "npx eas-cli@latest build --platform android --profile preview --non-interactive --clear-cache",
    "eas:build:production": "npx eas-cli@latest build --platform android --profile production --non-interactive",
    "eas:android:preview": "bash scripts/eas-android-preview.sh",
    "eas:fix-and-rebuild": "bash scripts/fix-lockfile-and-rebuild.sh"
  },
  "dependencies": {
    "@expo-google-fonts/nanum-pen-script": "^0.4.0",
    "@expo-google-fonts/noto-sans-kr": "^0.4.4",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-media-library": "~57.0.5",
    "expo-router": "~57.0.26",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  }
}
